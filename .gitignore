# ==============================================================================
.metro/
/top-level-binary-files
*.bundle
*.jsbundle
.buckd/
.watchman-inspector/
.flowconfig.lock

# ==============================================================================
# REACT NATIVE - ANDROID SPECIFIC
# ==============================================================================
# Build outputs
**/android/build/
**/android/app/build/
**/android/.gradle/
.gradle/

# Android Studio files
**/android/.idea/
**/android/*.iml
**/android/local.properties
**/android/.cxx/
**/android/captures/
*.apk
*.aar
*.keystore
!**/android/app/debug.keystore

# ==============================================================================
# REACT NATIVE - IOS SPECIFIC
# ==============================================================================
# Xcode outputs and user data
**/ios/DerivedData/
**/ios/build/
**/ios/*.xcodeproj/xcuserdata/
**/ios/*.xcworkspace/xcuserdata/
**/ios/*.xcodeproj/project.xcworkspace/
**/ios/.schemaFilter
**/ios/*.xcworkspace/xcshareddata/WorkspaceSettings.xcsettings

# CocoaPods
**/ios/Pods/
**/ios/Podfile.lock
**/ios/.xcode.env.local

# Fastlane
**/ios/fastlane/report.xml
**/ios/fastlane/Preview.html
**/ios/fastlane/screenshot

